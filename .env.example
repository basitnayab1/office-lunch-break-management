# =============================================================================
# Office Lunch Break Management System - Environment Variables
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local or service-account JSON key files to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase (Project Settings → API)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: password used for the seeded admin account (scripts/seed.ts)
# SEED_ADMIN_PASSWORD=AdminPass123!

# -----------------------------------------------------------------------------
# Google Sheets (service account — SERVER ONLY)
# Used by src/lib/google-sheets/service.ts and /api/google-sheets/test
# -----------------------------------------------------------------------------

# From the service account JSON: client_email
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com

# From the service account JSON: private_key
# Keep surrounding double quotes. Use \n for newlines (one line in .env.local).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional alternatives (recommended if private_key env is awkward):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN...","client_email":"..."}
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# Spreadsheet ID from the sheet URL:
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=1HFD6sBnBfQMsbuE5a9F87p_pqbcB5my-xvL-zSFId7o

# Tab / sheet name inside the spreadsheet (optional; default: Break Records)
GOOGLE_SHEET_NAME=Break Records

# REQUIRED: Share that spreadsheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor
# (Google Sheets UI → Share). Without this, sync returns HTTP 403.
